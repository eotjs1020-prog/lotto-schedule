DISCORD_TOKEN=YOUR_BOT_TOKEN
CLIENT_ID=YOUR_APPLICATION_CLIENT_ID
# Optional: set this for immediate slash command registration in one server.
GUILD_ID=YOUR_TEST_SERVER_GUILD_ID
# Weekly auto board (Asia/Seoul): Wed 00:00 post, Sun 23:59 close + summary. Omit to disable.
SCHEDULE_CHANNEL_ID=YOUR_TEXT_CHANNEL_SNOWFLAKE_ID
# Set to 1 once to test post+close in ~25s (no real cron). Remove after testing.
# SCHEDULE_SMOKE_TEST=1
# Optional: every viewer — on these calendar dates (Asia/Seoul), nobody can use day/time buttons.
# SCHEDULE_GLOBAL_WORK_DATES=2026-05-08,2026-05-09
# — user-work-schedule.json 의 global.workDates 와 합산. 조율 수~화 7일 창에 포함된 날이면 해당 요일 버튼이 빨강(선택 불가).
# SCHEDULE_VOTE_WEEK_OFFSET_WEEKS is unused (remove if you had it set).
# SCHEDULE_VOTE_WEEK_OFFSET_WEEKS=1
# Extra fixed weekday buttons to block (merged with workDates-derived weekdays): MON TUE WED THU FRI SAT SUN
# SCHEDULE_BLOCKED_DAY_KEYS=TUE,WED,THU
# Per-channel latest board: admins add red locks with /조율요일잠금 or /schedule_lock_days (merged with env + workDates + sheet locks).
# Optional: per-user work-day blocks for schedule buttons (copy user-work-schedule.example.json → user-work-schedule.json).
# USER_WORK_SCHEDULE_PATH=user-work-schedule.json
# (대시보드 /dashboard 의「일정 규칙·안내글」에서 같은 파일을 편집·저장할 수 있습니다.)
# Optional: who may use schedule board buttons (comma-separated Discord user IDs). Others get an ephemeral error.
# SCHEDULE_BUTTON_ALLOW_USER_IDS=111111111111111111,222222222222222222
# Optional: deny list (only used if you prefer block-list over allow-list; both can combine: must pass allow, then not in deny).
# SCHEDULE_BUTTON_DENY_USER_IDS=333333333333333333
# Optional: Google Sheets append on close (/일정마감 + 자동 마감).
# GOOGLE_SPREADSHEET_ID=your_spreadsheet_id
# GOOGLE_SHEET_RANGE=Sheet1!A:Z
# 실시간 시트: 아래 범위가 넓어도 조율판 열(시작 열 기준 11칸)만 갱신 — 오른쪽 집계표는 유지.
# GOOGLE_SHEET_LIVE_RANGE=Sheet1!A1:U50
# 시트 → 디스코드: 초 단위 폴링(0이면 끔). 관리자 /시트불러오기 로도 한 번 반영 가능.
# SCHEDULE_SHEET_IMPORT_INTERVAL_SEC=120
# SCHEDULE_SHEET_IMPORT_MAX_ROWS=300
# 시트 A열 표시명만으로는 멘션용 유저 ID를 알 수 없을 때 JSON: {"시트에쓴이름":"디스코드유저ID숫자",...}
# 또는 A열을 `표시이름|123456789012345678` 형식으로 적을 수 있음.
# SCHEDULE_SHEET_USER_MAP={"홍길동":"111111111111111111"}
# GOOGLE_SERVICE_ACCOUNT_EMAIL=bot-writer@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# --- Dashboard (OAuth + GUILD_ID 관리자 — /dashboard, /dashboard/api/snapshot.json) ---
# DASHBOARD_ENABLE=1
# OAuth2 → Client secret (봇 토큰과 다름): https://discord.com/developers/applications → 해당 앱 → OAuth2
# DISCORD_CLIENT_SECRET=your_application_client_secret
# Redirect URL 을 디스코드 개발자 포털 OAuth2에도 동일하게 등록해야 함 (예: https://도메인/auth/discord/callback)
# DASHBOARD_OAUTH_REDIRECT_URI=https://your-host.example.com/auth/discord/callback
# express-session 용 임의 긴 문자열
# DASHBOARD_SESSION_SECRET=랜덤으로_길게_한번_생성
# 비어 있으면 PORT, 아니면 전용 포트 (로컬은 3847 등)
# DASHBOARD_PORT=3847
# 바인드 주소 (기본 0.0.0.0). 외부에서 보려면 네이버 클라우드 ACG 등에서 인바운드 TCP(3847 등) 허용.
# DASHBOARD_BIND=0.0.0.0
# 집 PC 브라우저의 localhost ≠ 클라우드 서버. 접속은 http://공인IP또는도메인:3847/dashboard/login 또는 SSH -L 터널.
# OAuth Redirect URL은 접속하는 호스트와 포트와 일치해야 함 (예: https://도메인/auth/discord/callback)
# HTTPS 리버스 프록시 뒤에서 쿠키 Secure 쓰려면 1
# DASHBOARD_COOKIE_SECURE=0
