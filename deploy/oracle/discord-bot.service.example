# Copy to /etc/systemd/system/discord-bot.service after editing User, WorkingDirectory, ExecStart.
#   sudo cp discord-bot.service /etc/systemd/system/discord-bot.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now discord-bot
#   sudo systemctl status discord-bot
#   sudo journalctl -u discord-bot -f
#
# User / WorkingDirectory:
#   Ubuntu ARM/x86: User=ubuntu  WorkingDirectory=/home/ubuntu/discord-bot
#   Oracle Linux:   User=opc     WorkingDirectory=/home/opc/discord-bot
#
# ExecStart: on the VM run `which node` (or full path if you use nvm) and paste here.

[Unit]
Description=Discord weekly schedule bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/discord-bot
Environment=NODE_ENV=production
# dotenv loads .env from WorkingDirectory — chmod 600 .env, never commit .env
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
